	if (individual.age < 18 | individual.age > 40) return; 
	
potentialMates = subpop.individuals[(subpop.individuals.tag != individual.tag)];

// if no available mates, skip reproduction
if (length(potentialMates) == 0)
    return;

mate = sample(potentialMates, 1);
	// gradually increase K for p2 to simulate population expansion
	p2_K = p2_K_init + asInteger((p2_K_max - p2_K_init) * (community.tick - 50) / 200);
